# Copy to .env (git-ignored) and fill in. Never commit real values.
DB_URL=jdbc:mysql://HOST:PORT/DATABASE?sslMode=REQUIRED
DB_USERNAME=
DB_PASSWORD=

# Portal SSO: issuer URL (no trailing slash) and the public OAuth client registered for the VPN apps.
PORTAL_URL=https://sso.example.com
PORTAL_CLIENT_ID=hidenseek-vpn

# Public HTTPS URL of this backend; agents and apps call it.
PUBLIC_URL=https://vpn.example.com

ADMIN_EMAILS=you@example.com
AUTO_APPROVE_USERS=false
GEOIP_DATABASE=
ACTIVITY_RETENTION=30d
