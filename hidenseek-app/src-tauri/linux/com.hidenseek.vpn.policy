<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Lets the person at the computer connect and disconnect Hidenseek VPN without a password,
     like NetworkManager does for VPN connections. Remote and inactive sessions still need an
     administrator. The helper only configures its own "hidenseek" WireGuard interface. -->
<policyconfig>
  <vendor>Hidenseek VPN</vendor>
  <vendor_url>https://github.com/tanmaysinghx/hidenseek-vpn</vendor_url>
  <action id="com.hidenseek.vpn.tunnel">
    <description>Connect or disconnect Hidenseek VPN</description>
    <message>Hidenseek VPN needs permission to manage the VPN connection</message>
    <icon_name>hidenseek-app</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/hidenseek-app</annotate>
  </action>
</policyconfig>
