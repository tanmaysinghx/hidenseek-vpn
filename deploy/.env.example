# Public domain for the backend; point its DNS A record at this VPS. Caddy gets a TLS certificate.
DOMAIN=vpn.example.com
PUBLIC_URL=https://vpn.example.com

# MySQL 8 (managed, e.g. Aiven, or your own). Tables are prefixed hs_ so the database can be shared.
DB_URL=jdbc:mysql://HOST:PORT/DATABASE?sslMode=REQUIRED
DB_USERNAME=
DB_PASSWORD=

# Portal SSO. Register a confidential OAuth client (see docs/self-hosting.md).
PORTAL_URL=https://sso.example.com
PORTAL_CLIENT_ID=hidenseek-vpn
PORTAL_CLIENT_SECRET=

ADMIN_EMAILS=you@example.com
AUTO_APPROVE_USERS=false
ACTIVITY_RETENTION=30d

# Optional, for the geoip profile: https://www.maxmind.com/en/geolite2/signup
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=
